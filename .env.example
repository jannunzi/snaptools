# Amazon Associates tag used in every book link:
# https://www.amazon.com/dp/{ASIN}?tag={TAG}
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=jannunzi04-20

# Canonical site URL for sitemap, robots, and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side xAI key for Grok TTS, Imagine coloring pages, and
# History Timeline event fills. Never expose this to the client.
# Do not commit a real key.
# Vercel: Project → Settings → Environment Variables → XAI_API_KEY
# (Production, Preview, and Development). Then redeploy.
XAI_API_KEY=

# MongoDB Atlas connection string for History Timeline event cache.
# Keyed by category + granularity + aligned time window so Grok is
# not asked twice for the same span. MONGO_URI is accepted as a fallback.
# Database is always `snaptools` unless MONGODB_DB is set to something else.
# The course `web-dev` database is never used, even if it appears in the URI path.
# Vercel: Project → Settings → Environment Variables → MONGODB_URI
MONGODB_URI=
MONGODB_DB=snaptools

# Optional inbox for Math Labs teacher signups (email + "what next" note).
# HTTPS only. Formspree and generic collectors receive JSON:
# { email, interest, message, source, createdAt }.
# A Slack incoming webhook (hooks.slack.com) receives { text } instead.
# If this is unset, the form still works. Each signup is printed as
# [math-labs-signup] in the server log (local terminal, or Vercel → Logs).
# When MONGODB_URI is set, the same signup is also stored in
# snaptools.math_lab_signups. The build does not require this variable.
# Vercel: Project → Settings → Environment Variables → MATH_LABS_SIGNUP_WEBHOOK
MATH_LABS_SIGNUP_WEBHOOK=
