# Amazon Associates tag used in every book link:
# https://www.amazon.com/dp/{ASIN}?tag={TAG}
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=jannunzi04-20

# Canonical site URL for sitemap, robots, and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side xAI key for Grok TTS and Imagine coloring pages.
# Never expose this to the client. Do not commit a real key.
# Vercel: Project → Settings → Environment Variables → XAI_API_KEY
# (Production, Preview, and Development). Then redeploy.
XAI_API_KEY=
